{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "StudyPlan AI (Next.js)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/nextjs-app",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "- Local:.*(http://[^\\s]+)",
                "uriFormat": "%s"
            }
        }
    ]
}